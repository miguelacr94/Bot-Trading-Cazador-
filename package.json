{
  "name": "binance-spot-bot",
  "version": "1.0.0",
  "description": "Algorithmic Spot Trading Bot for Binance",
  "main": "dist/multi-engine-bot.js",
  "type": "module",
  "scripts": {
    "balance": "tsx src/cli.ts balance",
    "price": "tsx src/cli.ts price",
    "orders": "tsx src/cli.ts orders",
    "buy": "tsx src/cli.ts buy",
    "sell": "tsx src/cli.ts sell",
    "bot": "tsx src/cazador-completo.ts",
    "start": "tsx src/multi-engine-bot.ts",
    "build": "tsc",
    "cazador": "tsx src/cazador-completo.ts",
    "motores": "tsx src/multi-engine-bot.ts",
    "start:prod": "node --max-old-space-size=128 dist/multi-engine-bot.js",
    "dashboard": "tsx src/dashboard-server.ts",
    "microscalp": "tsx src/micro-scalper-engine.ts",
    "microscalp:reset": "tsx src/micro-scalper-engine.ts --reset",
    "futures": "tsx src/futures-engine.ts",
    "futures:sim": "tsx src/futures-engine.ts",
    "benchmark": "node dist/benchmark-tracker.js",
    "test": "tsx test/safety-guard.test.ts",
    "test:safety": "tsx test/safety-guard.test.ts"
  },
  "dependencies": {
    "@binance/connector": "^3.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
